# Copy this file to .env for localhost (copy .env.example .env). Never upload .env to GitHub.
# On Render, enter the same names under Environment instead of using a file.

SECRET_KEY=replace-with-a-long-random-value

# The admin account created on the first start. Without these, localhost uses
# admin@example.com / ChangeMe#2026, and Render creates no admin at all.
ADMIN_NAME=Portal Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe#2026

# Leave DATABASE_URL out to use the local SQLite file (research_grant_portal.db).
# DATABASE_URL=postgresql://USERNAME:PASSWORD@HOST:PORT/DATABASE

# Email for the one-time codes. With neither option below, codes are printed in the terminal.
#
# Option 1 (localhost): Gmail with an app password. Render's free plan blocks this.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=yourname@gmail.com
# SMTP_PASSWORD=your-16-character-app-password
# MAIL_FROM=yourname@gmail.com
#
# Option 2 (Render and localhost): Brevo's email API over HTTPS. Free plan: 300 emails a day.
# BREVO_API_KEY=xkeysib-your-key
# MAIL_FROM=the-sender-email-you-verified-in-brevo@gmail.com
